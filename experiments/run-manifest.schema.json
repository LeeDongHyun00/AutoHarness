      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_state": {
          "enum": [
            "unborn",
            "commit",
            "detached"
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "source_snapshot": {
          "type": "object",
          "properties": {
            "ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "access": {
              "enum": [
                "public",
                "owner_only",
                "evaluator_only"
              ]
            }
          },
          "required": [
            "ref",
            "sha256",
            "bytes",
            "access"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "repository",
        "commit",
        "branch",
        "head_state",
        "dirty",
        "source_snapshot"
