diff --git a/app/registrations.py b/app/registrations.py
index 4c11488..d84e8c9 100644
--- a/app/registrations.py
+++ b/app/registrations.py
@@ -116,7 +116,15 @@ def cancel(conn, registration_id, token):
     row = _registration_for_token(conn, registration_id, token)
     if row["status"] == "cancelled":
         return registration_to_dict(conn, row)
-    store.mark_cancelled(conn, row["id"], clock.now())
+    now = clock.now()
+    # Cancel and promotion are committed together so a freed seat is never
+    # visible as empty while someone is still waiting for it.
+    store.mark_cancelled(conn, row["id"], now)
+    if row["status"] == "confirmed":
+        event = store.get_event(conn, row["event_slug"])
+        next_in_line = store.first_waitlisted(conn, row["event_id"])
+        if next_in_line is not None and store.count_confirmed(conn, row["event_id"]) < event["capacity"]:
+            store.mark_confirmed(conn, next_in_line["id"], now)
     conn.commit()
     return registration_to_dict(conn, store.get_registration(conn, row["id"]))
 
