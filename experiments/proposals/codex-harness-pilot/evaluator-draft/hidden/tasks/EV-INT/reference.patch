+def first_waitlisted(conn, event_id):
+    return conn.execute(
+        "SELECT id FROM registrations WHERE event_id = ? AND status = 'waitlisted'"
+        " ORDER BY waitlisted_at, id LIMIT 1",
+        (event_id,),
+    ).fetchone()
+
+
+def mark_confirmed(conn, registration_id, now):
+    conn.execute(
+        "UPDATE registrations SET status = 'confirmed', confirmed_at = ? WHERE id = ?", (now, registration_id)
+    )
+
