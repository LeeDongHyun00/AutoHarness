@@ -114,6 +117,25 @@ def create_issue(conn, user_id, project_key, payload):
     return issue_to_dict(repository.get_issue(conn, project["id"], issue_id))
 
 
+def assign_issue(conn, user_id, project_key, issue_id, payload):
+    _, project = _project_access(conn, user_id, project_key, write=True)
+    if "assignee_id" not in payload:
+        raise BadRequest("assignee_id is required (use null to unassign)")
+    assignee_id = payload["assignee_id"]
+    # bool is a subclass of int; JSON true/false must not be read as user ids.
+    if assignee_id is not None and (not isinstance(assignee_id, int) or isinstance(assignee_id, bool)):
+        raise BadRequest("assignee_id must be an integer user id or null")
+    issue = _get_issue_or_404(conn, project, issue_id)
+    if assignee_id is not None:
+        assignee = repository.get_user(conn, assignee_id)
+        membership = repository.get_membership(conn, project["id"], assignee_id) if assignee else None
+        if assignee is None or not assignee["active"] or membership is None:
+            raise BadRequest("assignee must be an active member of this project")
+    repository.update_issue_assignee(conn, issue["id"], assignee_id, clock.now())
+    conn.commit()
+    return issue_to_dict(repository.get_issue(conn, project["id"], issue["id"]))
+
+
 def change_status(conn, user_id, project_key, issue_id, payload):
     _, project = _project_access(conn, user_id, project_key, write=True)
     status = payload.get("status")
